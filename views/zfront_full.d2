direction: down
...@../common/styles
...@../entities/zfront
title: {label: "ZFront · panels and shared services"; class: title; link: "../../controls/harnesses/diagram-guide.html"}
title.near: top-center
vars: {
  d2-legend: {
    a0.style.opacity: 0
    b0.style.opacity: 0
    a0 -- b0: "Power" {class: power; label: "Power"}
    a1.style.opacity: 0
    b1.style.opacity: 0
    a1 -- b1: "Ethernet" {class: ethernet; label: "Ethernet"}
    a2.style.opacity: 0
    b2.style.opacity: 0
    a2 -- b2: "Motor / position" {class: motion; label: "Motor / position"}
    a3.style.opacity: 0
    b3.style.opacity: 0
    a3 -- b3: "Air" {class: air; label: "Air"}
    a4.style.opacity: 0
    b4.style.opacity: 0
    a4 -- b4: "Sensor / I/O" {class: sense; label: "Sensor / I/O"}
    a5.style.opacity: 0
    b5.style.opacity: 0
    a5 -- b5: "Glycol pair" {class: glycol; label: "Glycol pair"}
  }
}
