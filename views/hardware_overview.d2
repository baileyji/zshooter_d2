direction: right
...@../common/styles
telescope: @../models/concepts.telescope
zfront: @../models/concepts.zfront
zimage: @../models/concepts.zimage
vis: @../models/concepts.vis
nir: @../models/concepts.nir
server: @../models/concepts.server
services: @../models/concepts.services
telescope -> zfront: {class: optical}
zfront -> zimage: {class: optical; label: "Imaging"}
zfront -> vis: {class: optical; label: "Spectroscopy"}
zfront -> nir: {class: optical; label: "Spectroscopy"}
zfront -> services: {class: control; label: "Distribute / monitor"}
zimage -> server: {class: data; label: "Readout"}
vis -> server: {class: data; label: "Readout"}
nir -> server: {class: data; label: "Readout"}
neighbor: {label: "Neighboring instruments"; class: device; link: "../../controls/operations/zfront-zcal.html"}
zfront -> neighbor: {class: optical}

title: {label: "ZShooter · explore the instrument"; class: title; link: "../../controls/harnesses/diagram-guide.html"}
title.near: top-center
vars: {
  d2-legend: {
    a0.style.opacity: 0
    b0.style.opacity: 0
    a0 -> b0: "Optical path" {class: optical; label: "Optical path"}
    a1.style.opacity: 0
    b1.style.opacity: 0
    a1 -> b1: "Frames / data" {class: data; label: "Frames / data"}
    a2.style.opacity: 0
    b2.style.opacity: 0
    a2 -> b2: "Control / state" {class: control; label: "Control / state"}
  }
}
