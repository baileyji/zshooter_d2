# zspec_nir_feedthroughs: visibility and layout only. Edit equipment and wiring in model/.
direction: right
...@../styles
...@../model/instrument

title: {label: "NIR Warm / Cold Connections"; class: title; near: top-center; link: "../../controls/harnesses/diagram-guide.html"}
vars: { d2-legend: @../legends.nir }

**: suspend
(** -- **)[*]: suspend
(** -> **)[*]: suspend
(** <-> **)[*]: suspend
# Follow cables across the vacuum boundary and the warm readout services.
# Internal motion-drive wiring is visible in zspec_nir_connections.
(rnas.zshooter.zspec_nir.cryostat.panels.support_vib.* -- **)[*]: unsuspend
(** -- rnas.zshooter.zspec_nir.cryostat.panels.support_vib.*)[*]: unsuspend
(rnas.zshooter.zspec_nir.cryostat.panels.detector_vib.* -- **)[*]: unsuspend
(** -- rnas.zshooter.zspec_nir.cryostat.panels.detector_vib.*)[*]: unsuspend
(rnas.zshooter.zspec_nir.archon* -- **)[*]: unsuspend { !&class: glycol }
(** -- rnas.zshooter.zspec_nir.archon*)[*]: unsuspend { !&class: glycol }
(rnas.zshooter.zspec_nir.slit_viewer -- **)[*]: unsuspend { !&class: glycol }
(** -- rnas.zshooter.zspec_nir.slit_viewer)[*]: unsuspend { !&class: glycol }
(rnas.zshooter.zspec_nir.ebox.temp_controller -- **)[*]: unsuspend { !&class: glycol }
(** -- rnas.zshooter.zspec_nir.ebox.temp_controller)[*]: unsuspend { !&class: glycol }
(rnas.zshooter.zspec_nir.ebox.input_panel.* -- **)[*]: unsuspend { !&class: glycol }
(** -- rnas.zshooter.zspec_nir.ebox.input_panel.*)[*]: unsuspend { !&class: glycol }
(rnas.zshooter.zspec_nir.ebox.network_switch -- rnas.zshooter.zspec_nir.ebox.panels.readout_panel.*)[*]: unsuspend
(rnas.zshooter.zspec_nir.ebox.network_switch -- rnas.zshooter.zspec_nir.ebox.panels.aux_panel.CAM*)[*]: unsuspend
(rnas.zshooter.zspec_nir.ebox.power_bus -- rnas.zshooter.zspec_nir.ebox.panels.readout_panel.*)[*]: unsuspend
(rnas.zshooter.zspec_nir.ebox.power_bus -- rnas.zshooter.zspec_nir.ebox.panels.aux_panel.CAM*)[*]: unsuspend
title: unsuspend
