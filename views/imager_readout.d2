direction: right
...@../common/styles
U: {
  label: "U channel"
  class: module
  link: "../../controls/harnesses/zimager.html#detector-readout"
  camera: {label: "U ORCA-Quest 2"; class: camera; link: "../../controls/harnesses/zimager.html#detector-readout"}
  panel: {
    label: "Detector panel"
    class: panel
    link: "../../controls/harnesses/zimager.html#detector-readout"
    CXP: "CoaXPress ×4"
  }
  tx: {label: "CXP optical transmitter"; class: [device; placeholder]; link: "../../controls/harnesses/zimager.html#detector-readout"}
  rack: {
    label: "Rack panel"
    class: panel
    link: "../../controls/harnesses/server.html"
    FIBER: "Optical transport"
  }
  rx: {label: "CXP optical receiver"; class: [device; placeholder]; link: "../../controls/harnesses/server.html"}
  card: {label: "U PCI readout card"; class: controller; link: "../../controls/harnesses/server.html"}
  camera -- panel.CXP: {class: cxp; label: ""}
  panel.CXP -- tx: {class: cxp; label: ""}
  tx -- rack.FIBER: {class: cxp; label: "Fiber"}
  rack.FIBER -- rx: {class: cxp; label: ""}
  rx -- card: {class: cxp; label: ""}
}
V: {
  label: "V channel"
  class: module
  link: "../../controls/harnesses/zimager.html#detector-readout"
  camera: {label: "V ORCA-Quest 2"; class: camera; link: "../../controls/harnesses/zimager.html#detector-readout"}
  panel: {
    label: "Detector panel"
    class: panel
    link: "../../controls/harnesses/zimager.html#detector-readout"
    CXP: "CoaXPress ×4"
  }
  tx: {label: "CXP optical transmitter"; class: [device; placeholder]; link: "../../controls/harnesses/zimager.html#detector-readout"}
  rack: {
    label: "Rack panel"
    class: panel
    link: "../../controls/harnesses/server.html"
    FIBER: "Optical transport"
  }
  rx: {label: "CXP optical receiver"; class: [device; placeholder]; link: "../../controls/harnesses/server.html"}
  card: {label: "V PCI readout card"; class: controller; link: "../../controls/harnesses/server.html"}
  camera -- panel.CXP: {class: cxp; label: ""}
  panel.CXP -- tx: {class: cxp; label: ""}
  tx -- rack.FIBER: {class: cxp; label: "Fiber"}
  rack.FIBER -- rx: {class: cxp; label: ""}
  rx -- card: {class: cxp; label: ""}
}
Z: {
  label: "Z channel"
  class: module
  link: "../../controls/harnesses/zimager.html#detector-readout"
  camera: {label: "Z ORCA-Quest 2"; class: camera; link: "../../controls/harnesses/zimager.html#detector-readout"}
  panel: {
    label: "Detector panel"
    class: panel
    link: "../../controls/harnesses/zimager.html#detector-readout"
    CXP: "CoaXPress ×4"
  }
  tx: {label: "CXP optical transmitter"; class: [device; placeholder]; link: "../../controls/harnesses/zimager.html#detector-readout"}
  rack: {
    label: "Rack panel"
    class: panel
    link: "../../controls/harnesses/server.html"
    FIBER: "Optical transport"
  }
  rx: {label: "CXP optical receiver"; class: [device; placeholder]; link: "../../controls/harnesses/server.html"}
  card: {label: "Z PCI readout card"; class: controller; link: "../../controls/harnesses/server.html"}
  camera -- panel.CXP: {class: cxp; label: ""}
  panel.CXP -- tx: {class: cxp; label: ""}
  tx -- rack.FIBER: {class: cxp; label: "Fiber"}
  rack.FIBER -- rx: {class: cxp; label: ""}
  rx -- card: {class: cxp; label: ""}
}
readout: {label: "ZImager readout host"; class: computer; link: "../../controls/operations/computer-management.html"}
nas: {label: "NAS / NFS"; class: computer; link: "../../controls/operations/computer-management.html"}
U.card -> readout: {class: data; label: "U"}
V.card -> readout: {class: data; label: "V"}
Z.card -> readout: {class: data; label: "Z"}
readout -> nas: {class: data; label: "Frames"}

title: {label: "Imager readout · one path per detector"; class: title; link: "../../controls/harnesses/diagram-guide.html"}
title.near: top-center
vars: {
  d2-legend: {
    a0.style.opacity: 0
    b0.style.opacity: 0
    a0 -- b0: "CoaXPress" {class: cxp; label: "CoaXPress"}
    a1.style.opacity: 0
    b1.style.opacity: 0
    a1 -> b1: "Frames / data" {class: data; label: "Frames / data"}
    selection: "Baseline selection" {class: [device; placeholder]}
  }
}
