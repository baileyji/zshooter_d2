direction: down
...@../common/styles
...@../entities/zshooter_hardware.hardware_system
rnas: suspend
zfront: suspend
zimage: suspend
server: suspend
mechanical: suspend
title: {label: "ZSpec · VIS / NIR panel connections"; class: title; link: "../../controls/harnesses/diagram-guide.html"}
title.near: top-center
vars: {
  d2-legend: {
    a0.style.opacity: 0
    b0.style.opacity: 0
    a0 -- b0: "Power" {class: power; label: "Power"}
    a1.style.opacity: 0
    b1.style.opacity: 0
    a1 -- b1: "EtherCAT" {class: ethercat; label: "EtherCAT"}
    a2.style.opacity: 0
    b2.style.opacity: 0
    a2 -- b2: "Motor / position" {class: motion; label: "Motor / position"}
    a3.style.opacity: 0
    b3.style.opacity: 0
    a3 -- b3: "Detector harness" {class: detector; label: "Detector harness"}
    a4.style.opacity: 0
    b4.style.opacity: 0
    a4 -- b4: "Glycol pair" {class: glycol; label: "Glycol pair"}
    a5.style.opacity: 0
    b5.style.opacity: 0
    a5 -- b5: "Vacuum" {class: vacuum; label: "Vacuum"}
    selection: "Baseline selection" {class: [device; placeholder]}
    option: "Optional component" {class: [device; optional]}
  }
}
