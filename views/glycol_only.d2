direction: down
...@../common/styles
facility: {label: "RNAS glycol supply / return"; class: utility; link: "../../controls/harnesses/glycol.html"}
central: {label: "ZFront monitored manifold"; class: manifold; link: "../../controls/harnesses/glycol.html"}
facility -- central: {class: glycol}
zfront: {label: "ZFront branch"; class: manifold; link: "../../controls/harnesses/glycol.html"}
zfront_loads: {label: "EBox heat exchanger"; class: device; link: "../../controls/harnesses/glycol.html"}
central -- zfront: {class: glycol}
zfront -- zfront_loads: {class: glycol}
zimage: {label: "ZImager isolated branch"; class: manifold; link: "../../controls/harnesses/glycol.html"}
zimage_loads: {label: "U / V / Z cameras + EBox"; class: device; link: "../../controls/harnesses/glycol.html"}
central -- zimage: {class: glycol}
zimage -- zimage_loads: {class: glycol}
vis: {label: "VIS isolated branch"; class: manifold; link: "../../controls/harnesses/glycol.html"}
vis_loads: {label: "Archons + coldheads + EBox"; class: device; link: "../../controls/harnesses/glycol.html"}
central -- vis: {class: glycol}
vis -- vis_loads: {class: glycol}
nir: {label: "NIR isolated branch"; class: manifold; link: "../../controls/harnesses/glycol.html"}
nir_loads: {label: "Archons + CRED2 + EBox"; class: device; link: "../../controls/harnesses/glycol.html"}
central -- nir: {class: glycol}
nir -- nir_loads: {class: glycol}
pump: {label: "Vacuum pump branch"; class: manifold; link: "../../controls/harnesses/glycol.html"}
pump_loads: {label: "Pump cooling"; class: device; link: "../../controls/harnesses/glycol.html"}
central -- pump: {class: glycol}
pump -- pump_loads: {class: glycol}
mechanical: {label: "Mechanical-room cooling"; class: utility; link: "../../controls/harnesses/glycol.html"}
compressor: {label: "NIR compressor"; class: device; link: "../../controls/harnesses/zspec-nir.html"}
mechanical -- compressor: {class: glycol}

title: {label: "Glycol · independent service branches"; class: title; link: "../../controls/harnesses/diagram-guide.html"}
title.near: top-center
vars: {
  d2-legend: {
    a0.style.opacity: 0
    b0.style.opacity: 0
    a0 -- b0: "Glycol pair" {class: glycol; label: "Glycol pair"}
  }
}
