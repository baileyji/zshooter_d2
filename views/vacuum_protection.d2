direction: right
...@../common/styles
pump: {label: "Shared roughing / turbo pump"; class: device; link: "../../controls/harnesses/vacuum.html"}
manifold: {label: "Vacuum manifold"; class: manifold; link: "../../controls/harnesses/vacuum.html"}
pump -- manifold: {class: vacuum}
B: {
  label: "B branch"
  class: module
  link: "../../controls/harnesses/vacuum.html"
  valve: {label: "Automatic gate valve"; class: controller; link: "../../controls/harnesses/vacuum.html"; tooltip: "Local protection; closes on loss of valve power."}
  gauge: {label: "Vacuum gauge"; class: device; link: "../../controls/harnesses/vacuum.html"}
  vessel: {label: "B vessel"; class: device; link: "../../controls/harnesses/vacuum.html"}
  valve -- vessel: {class: vacuum}
  gauge -- vessel: {class: vacuum}
}
manifold -- B.valve: {class: vacuum}
G: {
  label: "G branch"
  class: module
  link: "../../controls/harnesses/vacuum.html"
  valve: {label: "Automatic gate valve"; class: controller; link: "../../controls/harnesses/vacuum.html"; tooltip: "Local protection; closes on loss of valve power."}
  gauge: {label: "Vacuum gauge"; class: device; link: "../../controls/harnesses/vacuum.html"}
  vessel: {label: "G vessel"; class: device; link: "../../controls/harnesses/vacuum.html"}
  valve -- vessel: {class: vacuum}
  gauge -- vessel: {class: vacuum}
}
manifold -- G.valve: {class: vacuum}
R: {
  label: "R branch"
  class: module
  link: "../../controls/harnesses/vacuum.html"
  valve: {label: "Automatic gate valve"; class: controller; link: "../../controls/harnesses/vacuum.html"; tooltip: "Local protection; closes on loss of valve power."}
  gauge: {label: "Vacuum gauge"; class: device; link: "../../controls/harnesses/vacuum.html"}
  vessel: {label: "R vessel"; class: device; link: "../../controls/harnesses/vacuum.html"}
  valve -- vessel: {class: vacuum}
  gauge -- vessel: {class: vacuum}
}
manifold -- R.valve: {class: vacuum}
NIR: {
  label: "NIR branch"
  class: module
  link: "../../controls/harnesses/vacuum.html"
  valve: {label: "Automatic gate valve"; class: controller; link: "../../controls/harnesses/vacuum.html"; tooltip: "Local protection; closes on loss of valve power."}
  gauge: {label: "Vacuum gauge"; class: device; link: "../../controls/harnesses/vacuum.html"}
  vessel: {label: "NIR vessel"; class: device; link: "../../controls/harnesses/vacuum.html"}
  valve -- vessel: {class: vacuum}
  gauge -- vessel: {class: vacuum}
}
manifold -- NIR.valve: {class: vacuum}

title: {label: "Vacuum · local protection and isolation"; class: title; link: "../../controls/harnesses/diagram-guide.html"}
title.near: top-center
vars: {
  d2-legend: {
    a0.style.opacity: 0
    b0.style.opacity: 0
    a0 -- b0: "Vacuum" {class: vacuum; label: "Vacuum"}
  }
}
