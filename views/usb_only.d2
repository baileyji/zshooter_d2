direction: right
...@../common/styles
zimage: {label: "ZImager host"; class: computer; link: "../../controls/operations/computer-management.html"}
zimage_0: {label: "V filter"; class: controller; link: "../../controls/harnesses/zimager.html"}
zimage -- zimage_0: {class: usb}
zimage_1: {label: "1-Wire hub"; class: controller; link: "../../controls/harnesses/zimager.html"}
zimage -- zimage_1: {class: usb}
vis: {label: "VIS host"; class: computer; link: "../../controls/operations/computer-management.html"}
vis_0: {label: "Slit viewer"; class: controller; link: "../../controls/harnesses/zspec-vis.html"}
vis -- vis_0: {class: usb}
vis_1: {label: "1-Wire hub"; class: controller; link: "../../controls/harnesses/zspec-vis.html"}
vis -- vis_1: {class: usb}
vis_2: {label: "Gauge interface"; class: controller; link: "../../controls/harnesses/zspec-vis.html"}
vis -- vis_2: {class: usb}
vis_3: {label: "Cryotel controllers"; class: controller; link: "../../controls/harnesses/zspec-vis.html"}
vis -- vis_3: {class: usb}
nir: {label: "NIR host"; class: computer; link: "../../controls/operations/computer-management.html"}
nir_0: {label: "1-Wire hub"; class: controller; link: "../../controls/harnesses/zspec-nir.html"}
nir -- nir_0: {class: usb}
nir_1: {label: "Gauge interface"; class: controller; link: "../../controls/harnesses/zspec-nir.html"}
nir -- nir_1: {class: usb}

title: {label: "Local USB connections"; class: title; link: "../../controls/harnesses/diagram-guide.html"}
title.near: top-center
vars: {
  d2-legend: {
    a0.style.opacity: 0
    b0.style.opacity: 0
    a0 -- b0: "USB" {class: usb; label: "USB"}
  }
}
