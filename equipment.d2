# Reusable equipment defaults. Assembly-specific identity and wiring live in model/.
module_computer: {label: "rPi/Similar (Ubuntu)"; class: computer}
ethernet_switch: {label: "Ethernet Switch"; class: computer}
beckhoff_master: {label: "Beckhoff master"; class: controller}
temperature_hub: {label: "1-Wire hub"; class: controller}
heat_exchanger: {label: "Heat Exchanger"; class: device}
dc_supply: {label: "AC/DC supplies"; class: utility; tooltip: "Convert the incoming AC feed to the DC rails used by local distribution."}
dc_ups: {label: "DC UPS module"; class: [utility; optional]; tooltip: "Charging and backup connection to DC distribution. Fit where local battery support is needed."}
ac_distribution: {label: "AC distribution"; class: utility}
dc_distribution: {label: "DC distribution"; class: controller; tooltip: "Smart DC distribution with monitored, switchable outputs."}
archon: {label: "Archon"; class: controller; tooltip: "One Archon per detector."}
