zspec_nir: {
  label: "ZSpec NIR"
  class: module
  link: "../../controls/harnesses/zspec-nir.html"
  ebox: {
    label: "NIR EBox"
    class: ebox
    link: "../../controls/harnesses/zspec-nir.html"
    power_bus: {...@../equipment.dc_distribution; link: "../../controls/harnesses/zspec-nir.html"}
    network_switch: {...@../equipment.ethernet_switch; link: "../../controls/harnesses/zspec-nir.html"}
    computer: {...@../equipment.module_computer; link: "../../controls/operations/computer-management.html"}
    master: {...@../equipment.beckhoff_master; link: "../../controls/harnesses/zspec-nir.html"}
    temperature_hub: {...@../equipment.temperature_hub; link: "../../controls/harnesses/zspec-nir.html"}
    heat_exchanger: {...@../equipment.heat_exchanger; link: "../../controls/harnesses/zspec-nir.html"}
    input_panel.DC -- power_bus: {class: [dc; power_feed]}
    input_panel.NET -- network_switch: {class: ethernet}
    power_bus -- computer: {class: [dc; power_feed]}
    power_bus -- master: {class: dc}
    power_bus -- network_switch: {class: dc}
    network_switch -- computer: {class: ethernet}
    network_switch -- master: {class: ethernet}
    computer -- temperature_hub: {class: usb}
    temperature_hub -- panels.aux_panel.TEMP: {class: sense; label: "1-Wire"}
    drive_pupil: {label: "Cold-pupil rotator drive"; class: controller; link: "../../controls/operations/zspec.html"}
    power_bus -- drive_pupil: {class: dc}
    master -- drive_pupil: {class: ethercat}
    drive_pupil -- panels.motion_panel.PUPIL: {class: motion}
    drive_adc_a: {label: "ADC prism A drive"; class: controller; link: "../../controls/operations/zspec.html"}
    power_bus -- drive_adc_a: {class: dc}
    master -- drive_adc_a: {class: ethercat}
    drive_adc_a -- panels.motion_panel.ADC_A: {class: motion}
    drive_adc_b: {label: "ADC prism B drive"; class: controller; link: "../../controls/operations/zspec.html"}
    power_bus -- drive_adc_b: {class: dc}
    master -- drive_adc_b: {class: ethercat}
    drive_adc_b -- panels.motion_panel.ADC_B: {class: motion}
    drive_rotator: {label: "Field rotator drive"; class: controller; link: "../../controls/operations/zspec.html"}
    power_bus -- drive_rotator: {class: dc}
    master -- drive_rotator: {class: ethercat}
    drive_rotator -- panels.motion_panel.ROTATOR: {class: motion}
    drive_steer_x: {label: "X steering drive"; class: controller; link: "../../controls/operations/zspec.html"}
    power_bus -- drive_steer_x: {class: dc}
    master -- drive_steer_x: {class: ethercat}
    drive_steer_x -- panels.motion_panel.STEER_X: {class: motion}
    drive_steer_y: {label: "Y steering drive"; class: controller; link: "../../controls/operations/zspec.html"}
    power_bus -- drive_steer_y: {class: dc}
    master -- drive_steer_y: {class: ethercat}
    drive_steer_y -- panels.motion_panel.STEER_Y: {class: motion}
    drive_slit: {label: "Slit Selector drive"; class: controller; link: "../../controls/operations/zspec.html"}
    power_bus -- drive_slit: {class: dc}
    master -- drive_slit: {class: ethercat}
    drive_slit -- panels.motion_panel.SLIT: {class: motion}
    drive_focus_yj: {label: "YJ focus drive"; class: controller; link: "../../controls/operations/zspec.html"}
    power_bus -- drive_focus_yj: {class: dc}
    master -- drive_focus_yj: {class: ethercat}
    drive_focus_yj -- panels.motion_panel.FOCUS_YJ: {class: motion}
    drive_focus_h: {label: "H focus drive"; class: controller; link: "../../controls/operations/zspec.html"}
    power_bus -- drive_focus_h: {class: dc}
    master -- drive_focus_h: {class: ethercat}
    drive_focus_h -- panels.motion_panel.FOCUS_H: {class: motion}
    drive_focus_k: {label: "K focus drive"; class: controller; link: "../../controls/operations/zspec.html"}
    power_bus -- drive_focus_k: {class: dc}
    master -- drive_focus_k: {class: ethercat}
    drive_focus_k -- panels.motion_panel.FOCUS_K: {class: motion}
    panels.cooling_panel.GLYCOL -- heat_exchanger: {class: glycol}
    shutter_or: {label: "Shutter hardware OR"; class: controller; link: "../../controls/harnesses/zspec-nir.html#shutter-triggers"}
    shutter_controller: {label: "Shutter controller"; class: controller; link: "../../controls/harnesses/zspec-nir.html#shutter-triggers"}
    power_bus -- panels.readout_panel.YJ_POWER: {class: dc}
    network_switch -- panels.readout_panel.YJ_NET: {class: ethernet}
    panels.readout_panel.YJ_TRIG -> shutter_or: {class: trigger; label: "YJ"}
    power_bus -- panels.readout_panel.H_POWER: {class: dc}
    network_switch -- panels.readout_panel.H_NET: {class: ethernet}
    panels.readout_panel.H_TRIG -> shutter_or: {class: trigger; label: "H"}
    power_bus -- panels.readout_panel.K_POWER: {class: dc}
    network_switch -- panels.readout_panel.K_NET: {class: ethernet}
    panels.readout_panel.K_TRIG -> shutter_or: {class: trigger; label: "K"}
    shutter_or -> shutter_controller: {class: trigger}
    power_bus -- shutter_or: {class: dc}
    power_bus -- shutter_controller: {class: dc}
    master -- shutter_controller: {class: ethercat}
    shutter_controller -- panels.motion_panel.SHUTTER: {class: motion}
    power_bus -- panels.aux_panel.CAM_POWER: {class: dc}
    network_switch -- panels.aux_panel.CAM_DATA: {class: ethernet}
    computer -- panels.aux_panel.GAUGES: {class: [usb; usb_serial]}
    power_bus -- panels.aux_panel.GAUGE_DC: {class: dc}
    power_bus -- panels.aux_panel.VALVE_DC: {class: dc}
    panels.motion_panel.SHUTTER: "Cold shutter"
    temp_controller: {label: "Thermocopia Temperature Controller"; class: controller; link: "../../controls/harnesses/zspec-nir.html#support-motion-vib"}
    network_switch -- temp_controller: {class: ethernet}
    power_bus -- temp_controller: {class: dc}
    temp_controller -- panels.thermal_panel.SENSE: {class: sense; label: "Temperature"}
    temp_controller -- panels.thermal_panel.HEAT: {class: dc; label: "Heaters"}
    # Separate input from outgoing panels to preserve service flow in layout.
    input_panel: {
      label: "Service input panel"
      class: panel
      link: "../../controls/harnesses/zspec-nir.html"
      DC: "Power"
      NET: "Control / readout"
    }
    panels: {
      class: panel_group
      motion_panel: {
        label: "Mechanism panel"
        class: panel
        link: "../../controls/harnesses/zspec-nir.html"
        PUPIL: "Cold-pupil rotator"
        ADC_A: "ADC prism A"
        ADC_B: "ADC prism B"
        ROTATOR: "Field rotator"
        STEER_X: "X steering"
        STEER_Y: "Y steering"
        SLIT: "Slit Selector"
        FOCUS_YJ: "YJ focus"
        FOCUS_H: "H focus"
        FOCUS_K: "K focus"
      }
      aux_panel: {
        label: "Auxiliary panel"
        class: panel
        link: "../../controls/harnesses/zspec-nir.html"
        TEMP: "Temperature Sensors"
        CAM_POWER: "Slit viewer DC"
        CAM_DATA: "Slit viewer data"
        GAUGES: "Vacuum readout"
        GAUGE_DC: "Gauge power"
        VALVE_DC: "Gate-valve power"
      }
      cooling_panel: {
        label: "Cooling panel"
        class: panel
        link: "../../controls/harnesses/zspec-nir.html#glycol-connections"
        GLYCOL: "Supply / return"
      }
      readout_panel: {
        label: "Readout panel"
        class: panel
        link: "../../controls/harnesses/zspec-nir.html"
        YJ_POWER: "Archon DC"
        YJ_NET: "Archon network"
        YJ_TRIG: "Shutter trigger"
        H_POWER: "Archon DC"
        H_NET: "Archon network"
        H_TRIG: "Shutter trigger"
        K_POWER: "Archon DC"
        K_NET: "Archon network"
        K_TRIG: "Shutter trigger"
      }
      thermal_panel: {
        label: "Thermal control panel"
        class: panel
        link: "../../controls/harnesses/zspec-nir.html#support-motion-vib"
        SENSE: "Temperature sensors"
        HEAT: "Heaters"
      }
    }
  }
  glycol_manifold: {label: "NIR glycol manifold"; class: manifold; link: "../../controls/harnesses/zspec-nir.html#glycol-connections"}
  glycol_manifold -- ebox.panels.cooling_panel.GLYCOL: {class: glycol}
  slit_viewer: {label: "CRED2 slit viewer"; class: camera; link: "../../controls/harnesses/zspec-nir.html#slit-viewer-connections"}
  ebox.panels.aux_panel.CAM_POWER -- slit_viewer: {class: dc}
  ebox.panels.aux_panel.CAM_DATA -- slit_viewer: {class: ethernet}
  glycol_manifold -- slit_viewer: {class: glycol}
  enclosure_probes: {label: "Temperature Sensors"; class: device; link: "../../controls/harnesses/zspec-nir.html"}
  ebox.panels.aux_panel.TEMP -- enclosure_probes: {class: sense; label: "1-Wire"}
  cryostat: {
    label: "NIR cryostat"
    class: cryostat
    link: "../../controls/harnesses/zspec-nir.html"
    pupil_rotator: {label: "Cold-pupil rotator"; class: actuator; link: "../../controls/operations/zspec.html"}
    panels.support_vib.PUPIL -- pupil_rotator: {class: motion}
    adc_a: {label: "ADC prism A"; class: actuator; link: "../../controls/operations/zspec.html"}
    panels.support_vib.ADC_A -- adc_a: {class: motion}
    adc_b: {label: "ADC prism B"; class: actuator; link: "../../controls/operations/zspec.html"}
    panels.support_vib.ADC_B -- adc_b: {class: motion}
    rotator: {label: "Field rotator"; class: actuator; link: "../../controls/operations/zspec.html"}
    panels.support_vib.ROTATOR -- rotator: {class: motion}
    steer_x: {label: "X steering"; class: actuator; link: "../../controls/operations/zspec.html"}
    panels.support_vib.STEER_X -- steer_x: {class: motion}
    steer_y: {label: "Y steering"; class: actuator; link: "../../controls/operations/zspec.html"}
    panels.support_vib.STEER_Y -- steer_y: {class: motion}
    slit: {label: "Slit Selector"; class: actuator; link: "../../controls/operations/zspec.html"}
    panels.support_vib.SLIT -- slit: {class: motion}
    focus_yj: {label: "YJ focus"; class: actuator; link: "../../controls/operations/zspec.html"}
    panels.support_vib.FOCUS_YJ -- focus_yj: {class: motion}
    focus_h: {label: "H focus"; class: actuator; link: "../../controls/operations/zspec.html"}
    panels.support_vib.FOCUS_H -- focus_h: {class: motion}
    focus_k: {label: "K focus"; class: actuator; link: "../../controls/operations/zspec.html"}
    panels.support_vib.FOCUS_K -- focus_k: {class: motion}
    shutter: {label: "Cold shutter"; class: actuator; link: "../../controls/operations/zspec.html"}
    panels.support_vib.SHUTTER -- shutter: {class: motion}
    thermal_sensors: {label: "Thermal sensors"; class: device; link: "../../controls/harnesses/zspec-nir.html"}
    heaters: {label: "Heaters"; class: device; link: "../../controls/harnesses/zspec-nir.html"}
    panels.support_vib.SENSE -- thermal_sensors: {class: sense; label: "Temperature"}
    panels.support_vib.HEAT -- heaters: {class: dc}
    detector_yj: {label: "YJ LmAPD"; class: camera; link: "../../controls/operations/zspec.html"}
    panels.detector_vib.YJ -- detector_yj: {class: detector}
    panels.detector_vib.YJ_THERM -- detector_yj: {class: sense; label: "Temperature / heater"}
    detector_h: {label: "H LmAPD"; class: camera; link: "../../controls/operations/zspec.html"}
    panels.detector_vib.H -- detector_h: {class: detector}
    panels.detector_vib.H_THERM -- detector_h: {class: sense; label: "Temperature / heater"}
    detector_k: {label: "K LmAPD"; class: camera; link: "../../controls/operations/zspec.html"}
    panels.detector_vib.K -- detector_k: {class: detector}
    panels.detector_vib.K_THERM -- detector_k: {class: sense; label: "Temperature / heater"}
    gate_valve: {label: "NIR automatic gate valve"; class: controller; tooltip: "Part of the cryostat assembly; mounted outside vacuum."; link: "../../controls/harnesses/vacuum.html"}
    vacuum_gauge: {label: "NIR vacuum gauge"; class: device; tooltip: "Mounted on the cryostat, outside vacuum."; link: "../../controls/harnesses/vacuum.html"}
    panels: {
      class: panel_group
      support_vib: {
        label: "Support / motion VIB"
        class: panel
        link: "../../controls/harnesses/zspec-nir.html#support-motion-vib"
        PUPIL: "Cold-pupil rotator"
        ADC_A: "ADC prism A"
        ADC_B: "ADC prism B"
        ROTATOR: "Field rotator"
        STEER_X: "X steering"
        STEER_Y: "Y steering"
        SLIT: "Slit Selector"
        FOCUS_YJ: "YJ focus"
        FOCUS_H: "H focus"
        FOCUS_K: "K focus"
        SHUTTER: "Cold shutter"
        SENSE: "Temperature sensors"
        HEAT: "Heaters"
      }
      detector_vib: {
        label: "Detector VIB"
        class: panel
        link: "../../controls/harnesses/zspec-nir.html#detector-vib"
        YJ: "Detector harness"
        H: "Detector harness"
        K: "Detector harness"
        YJ_THERM: "Detector thermal circuits"
        H_THERM: "Detector thermal circuits"
        K_THERM: "Detector thermal circuits"
      }
      service_ports: {
        label: "Cryostat ports"
        class: panel
        link: "../../controls/harnesses/zspec-nir.html"
        VAC: "Vacuum"
        COLD: "Coldhead interface"
      }
    }
  }
  ebox.panels.motion_panel.PUPIL -- cryostat.panels.support_vib.PUPIL: {class: motion}
  ebox.panels.motion_panel.ADC_A -- cryostat.panels.support_vib.ADC_A: {class: motion}
  ebox.panels.motion_panel.ADC_B -- cryostat.panels.support_vib.ADC_B: {class: motion}
  ebox.panels.motion_panel.ROTATOR -- cryostat.panels.support_vib.ROTATOR: {class: motion}
  ebox.panels.motion_panel.STEER_X -- cryostat.panels.support_vib.STEER_X: {class: motion}
  ebox.panels.motion_panel.STEER_Y -- cryostat.panels.support_vib.STEER_Y: {class: motion}
  ebox.panels.motion_panel.SLIT -- cryostat.panels.support_vib.SLIT: {class: motion}
  ebox.panels.motion_panel.FOCUS_YJ -- cryostat.panels.support_vib.FOCUS_YJ: {class: motion}
  ebox.panels.motion_panel.FOCUS_H -- cryostat.panels.support_vib.FOCUS_H: {class: motion}
  ebox.panels.motion_panel.FOCUS_K -- cryostat.panels.support_vib.FOCUS_K: {class: motion}
  ebox.panels.motion_panel.SHUTTER -- cryostat.panels.support_vib.SHUTTER: {class: motion}
  ebox.panels.thermal_panel.SENSE -- cryostat.panels.support_vib.SENSE: {class: sense; label: "Temperature"}
  ebox.panels.thermal_panel.HEAT -- cryostat.panels.support_vib.HEAT: {class: dc}
  archon_yj: {...@../equipment.archon; label: "YJ Archon"; link: "../../controls/harnesses/zspec-nir.html#detector-vib"}
  ebox.panels.readout_panel.YJ_POWER -- archon_yj: {class: dc}
  ebox.panels.readout_panel.YJ_NET -- archon_yj: {class: ethernet}
  archon_yj -> ebox.panels.readout_panel.YJ_TRIG: {class: trigger; label: "YJ"}
  archon_yj -- cryostat.panels.detector_vib.YJ: {class: detector}
  glycol_manifold -- archon_yj: {class: glycol}
  archon_yj -- cryostat.panels.detector_vib.YJ_THERM: {class: sense; label: "Sense / heater"}
  archon_h: {...@../equipment.archon; label: "H Archon"; link: "../../controls/harnesses/zspec-nir.html#detector-vib"}
  ebox.panels.readout_panel.H_POWER -- archon_h: {class: dc}
  ebox.panels.readout_panel.H_NET -- archon_h: {class: ethernet}
  archon_h -> ebox.panels.readout_panel.H_TRIG: {class: trigger; label: "H"}
  archon_h -- cryostat.panels.detector_vib.H: {class: detector}
  glycol_manifold -- archon_h: {class: glycol}
  archon_h -- cryostat.panels.detector_vib.H_THERM: {class: sense; label: "Sense / heater"}
  archon_k: {...@../equipment.archon; label: "K Archon"; link: "../../controls/harnesses/zspec-nir.html#detector-vib"}
  ebox.panels.readout_panel.K_POWER -- archon_k: {class: dc}
  ebox.panels.readout_panel.K_NET -- archon_k: {class: ethernet}
  archon_k -> ebox.panels.readout_panel.K_TRIG: {class: trigger; label: "K"}
  archon_k -- cryostat.panels.detector_vib.K: {class: detector}
  glycol_manifold -- archon_k: {class: glycol}
  archon_k -- cryostat.panels.detector_vib.K_THERM: {class: sense; label: "Sense / heater"}
  coldhead: {label: "NIR coldhead"; class: device; link: "../../controls/harnesses/zspec-nir.html#coldhead-and-compressor-connections"}
  coldhead -- cryostat.panels.service_ports.COLD: {class: thermal; label: "Cold finger"}
  ebox.panels.aux_panel.GAUGES -- cryostat.vacuum_gauge: {class: [usb; usb_serial]}
  ebox.panels.aux_panel.GAUGE_DC -- cryostat.vacuum_gauge: {class: dc}
  ebox.panels.aux_panel.VALVE_DC -- cryostat.gate_valve: {class: dc}
  cryostat.vacuum_gauge -- cryostat.panels.service_ports.VAC: {class: vacuum}
  cryostat.gate_valve -- cryostat.panels.service_ports.VAC: {class: vacuum}
}
