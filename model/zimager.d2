# Change the filter label or interface here; both cable segments and every view follow.
vars: {
  filter: {
    label: "V filter"
    interface: usb
  }
}
zimager: {
  label: "ZImager"
  class: module
  link: "../../controls/harnesses/zimager.html"
  ebox: {
    label: "ZImager EBox"
    class: ebox
    link: "../../controls/harnesses/zimager.html"
    power_bus: {...@../equipment.ac_distribution; link: "../../controls/harnesses/zimager.html"}
    dc: {...@../equipment.dc_supply; link: "../../controls/harnesses/zimager.html"}
    dc_distribution: {...@../equipment.dc_distribution; link: "../../controls/harnesses/power.html"}
    dc_ups: {...@../equipment.dc_ups; link: "../../controls/harnesses/power.html"}
    network_switch: {...@../equipment.ethernet_switch; link: "../../controls/harnesses/zimager.html"}
    computer: {...@../equipment.module_computer; link: "../../controls/operations/computer-management.html"}
    master: {...@../equipment.beckhoff_master; link: "../../controls/harnesses/zimager.html"}
    temperature_hub: {...@../equipment.temperature_hub; link: "../../controls/harnesses/zimager.html"}
    heat_exchanger: {...@../equipment.heat_exchanger; link: "../../controls/harnesses/zimager.html"}
    input_panel.AC -- power_bus: {class: power}
    power_bus -- dc: {class: power}
    dc -- dc_distribution: {class: dc}
    dc_distribution -- dc_ups: {class: dc}
    input_panel.NET -- network_switch: {class: ethernet}
    dc_distribution -- computer: {class: dc}
    dc_distribution -- master: {class: dc}
    dc_distribution -- network_switch: {class: dc}
    network_switch -- dc_distribution: {class: ethernet}
    network_switch -- computer: {class: ethernet}
    network_switch -- master: {class: ethernet}
    computer -- temperature_hub: {class: [usb; carries_power]}
    temperature_hub -- panels.motion_panel.TEMP: {class: [sense; carries_power]; label: "1-Wire"}
    computer -- panels.motion_panel.FILTER: {class: ${filter.interface}}
    dc_distribution -- panels.motion_panel.FILTER_POWER: {class: dc; label: "24 VDC"}
    panels.cooling_panel.GLYCOL -- heat_exchanger: {class: glycol}
    # Separate input from outgoing panels to preserve service flow in layout.
    input_panel: {
      label: "Service input panel"
      class: panel
      link: "../../controls/harnesses/zimager.html"
      AC: "Power"
      NET: "Ethernet"
    }
    fiber_panel: {
      label: "CXP fiber panel"
      class: panel
      link: "../../controls/harnesses/zimager.html#detector-readout"
      U: "U optical transport"
      V: "V optical transport"
      Z: "Z optical transport"
    }
    panels: {
      class: panel_group
      motion_panel: {
        label: "Mechanism / detector panel"
        class: panel
        link: "../../controls/harnesses/zimager.html"
        ADC_A: "ADC prism A"
        ADC_B: "ADC prism B"
        ROT_U: "U detector rotator"
        ROT_V: "V detector rotator"
        ROT_Z: "Z detector rotator"
        FOCUS: "Common focus"
        FILTER: ${filter.label}
        FILTER_POWER: "Filter power"
        TEMP: "1Wire Temp Sensors"
        U_DC: "U detector power"
        V_DC: "V detector power"
        Z_DC: "Z detector power"
        U_CXP: "U CoaXPress ×4"
        V_CXP: "V CoaXPress ×4"
        Z_CXP: "Z CoaXPress ×4"
      }
      cooling_panel: {
        label: "Cooling panel"
        class: panel
        link: "../../controls/harnesses/zimager.html#glycol-connections"
        GLYCOL: "Supply / return"
      }
    }
  }
  enclosure: {
    label: "ZImager enclosure"
    class: module
    link: "../../controls/harnesses/zimager.html"
    enclosure_probes: {label: "1Wire Temp Sensors"; class: device; link: "../../controls/harnesses/zimager.html"}
    adc_a: {label: "ADC prism A"; class: actuator; link: "../../controls/operations/zimager.html"}
    adc_b: {label: "ADC prism B"; class: actuator; link: "../../controls/operations/zimager.html"}
    u_rotator: {label: "U detector rotator"; class: actuator; link: "../../controls/operations/zimager.html"}
    v_rotator: {label: "V detector rotator"; class: actuator; link: "../../controls/operations/zimager.html"}
    z_rotator: {label: "Z detector rotator"; class: actuator; link: "../../controls/operations/zimager.html"}
    focus: {label: "Common focus"; class: actuator; link: "../../controls/operations/zimager.html"}
    filter: {label: ${filter.label}; tooltip: "Filter selection applies to the V channel."; class: actuator; link: "../../controls/operations/zimager.html"}
    air_dryer: {label: "Enclosure air dryer"; class: utility; link: "../../controls/harnesses/zimager.html#air-connections"}
  }
  glycol_manifold: {label: "Glycol submanifold"; class: manifold; link: "../../controls/harnesses/zimager.html#glycol-connections"}
  ebox.panels.motion_panel.FILTER -- enclosure.filter: {class: ${filter.interface}}
  ebox.panels.motion_panel.FILTER_POWER -- enclosure.filter: {class: dc; label: "24 VDC"}
  ebox.panels.motion_panel.TEMP -- enclosure.enclosure_probes: {class: [sense; carries_power]; label: "1-Wire"}
  glycol_manifold -- ebox.panels.cooling_panel.GLYCOL: {class: glycol}
  ebox.drive_adc_a: {label: "ADC prism A drive"; class: controller; link: "../../controls/operations/zimager.html"}
  ebox.dc_distribution -- ebox.drive_adc_a: {class: dc}
  ebox.master -- ebox.drive_adc_a: {class: ethercat}
  ebox.drive_adc_a -- ebox.panels.motion_panel.ADC_A: {class: motion}
  ebox.panels.motion_panel.ADC_A -- enclosure.adc_a: {class: motion}
  ebox.drive_adc_b: {label: "ADC prism B drive"; class: controller; link: "../../controls/operations/zimager.html"}
  ebox.dc_distribution -- ebox.drive_adc_b: {class: dc}
  ebox.master -- ebox.drive_adc_b: {class: ethercat}
  ebox.drive_adc_b -- ebox.panels.motion_panel.ADC_B: {class: motion}
  ebox.panels.motion_panel.ADC_B -- enclosure.adc_b: {class: motion}
  ebox.drive_rot_u: {label: "U detector rotator drive"; class: controller; link: "../../controls/operations/zimager.html"}
  ebox.dc_distribution -- ebox.drive_rot_u: {class: dc}
  ebox.master -- ebox.drive_rot_u: {class: ethercat}
  ebox.drive_rot_u -- ebox.panels.motion_panel.ROT_U: {class: motion}
  ebox.panels.motion_panel.ROT_U -- enclosure.u_rotator: {class: motion}
  ebox.drive_rot_v: {label: "V detector rotator drive"; class: controller; link: "../../controls/operations/zimager.html"}
  ebox.dc_distribution -- ebox.drive_rot_v: {class: dc}
  ebox.master -- ebox.drive_rot_v: {class: ethercat}
  ebox.drive_rot_v -- ebox.panels.motion_panel.ROT_V: {class: motion}
  ebox.panels.motion_panel.ROT_V -- enclosure.v_rotator: {class: motion}
  ebox.drive_rot_z: {label: "Z detector rotator drive"; class: controller; link: "../../controls/operations/zimager.html"}
  ebox.dc_distribution -- ebox.drive_rot_z: {class: dc}
  ebox.master -- ebox.drive_rot_z: {class: ethercat}
  ebox.drive_rot_z -- ebox.panels.motion_panel.ROT_Z: {class: motion}
  ebox.panels.motion_panel.ROT_Z -- enclosure.z_rotator: {class: motion}
  ebox.drive_focus: {label: "Common focus drive"; class: controller; link: "../../controls/operations/zimager.html"}
  ebox.dc_distribution -- ebox.drive_focus: {class: dc}
  ebox.master -- ebox.drive_focus: {class: ethercat}
  ebox.drive_focus -- ebox.panels.motion_panel.FOCUS: {class: motion}
  ebox.panels.motion_panel.FOCUS -- enclosure.focus: {class: motion}
  enclosure.detector_u: {label: "U ORCA-Quest 2"; class: camera; link: "../../controls/operations/zimager.html#detector-acquisition"}
  ebox.dc_distribution -- ebox.transmitters.u: {class: dc}
  ebox.dc_distribution -- ebox.panels.motion_panel.U_DC: {class: dc; label: "12 VDC"}
  ebox.panels.motion_panel.U_DC -- enclosure.detector_u: {class: dc; label: "12 VDC"}
  enclosure.detector_u -- ebox.panels.motion_panel.U_CXP: {class: cxp}
  ebox.panels.motion_panel.U_CXP -- ebox.transmitters.u: {class: cxp}
  ebox.transmitters.u -- ebox.fiber_panel.U: {class: cxp_fiber}
  glycol_manifold -- enclosure.detector_u: {class: glycol}
  enclosure.detector_v: {label: "V ORCA-Quest 2"; class: camera; link: "../../controls/operations/zimager.html#detector-acquisition"}
  ebox.dc_distribution -- ebox.transmitters.v: {class: dc}
  ebox.dc_distribution -- ebox.panels.motion_panel.V_DC: {class: dc; label: "12 VDC"}
  ebox.panels.motion_panel.V_DC -- enclosure.detector_v: {class: dc; label: "12 VDC"}
  enclosure.detector_v -- ebox.panels.motion_panel.V_CXP: {class: cxp}
  ebox.panels.motion_panel.V_CXP -- ebox.transmitters.v: {class: cxp}
  ebox.transmitters.v -- ebox.fiber_panel.V: {class: cxp_fiber}
  glycol_manifold -- enclosure.detector_v: {class: glycol}
  enclosure.detector_z: {label: "Z ORCA-Quest 2"; class: camera; link: "../../controls/operations/zimager.html#detector-acquisition"}
  ebox.dc_distribution -- ebox.transmitters.z: {class: dc}
  ebox.dc_distribution -- ebox.panels.motion_panel.Z_DC: {class: dc; label: "12 VDC"}
  ebox.panels.motion_panel.Z_DC -- enclosure.detector_z: {class: dc; label: "12 VDC"}
  enclosure.detector_z -- ebox.panels.motion_panel.Z_CXP: {class: cxp}
  ebox.panels.motion_panel.Z_CXP -- ebox.transmitters.z: {class: cxp}
  ebox.transmitters.z -- ebox.fiber_panel.Z: {class: cxp_fiber}
  glycol_manifold -- enclosure.detector_z: {class: glycol}
  ebox.transmitters: {
    class: panel_group
    u: {label: "U CXP optical transmitter"; class: controller; link: "../../controls/harnesses/zimager.html#detector-readout"}
    v: {label: "V CXP optical transmitter"; class: controller; link: "../../controls/harnesses/zimager.html#detector-readout"}
    z: {label: "Z CXP optical transmitter"; class: controller; link: "../../controls/harnesses/zimager.html#detector-readout"}
  }
}
