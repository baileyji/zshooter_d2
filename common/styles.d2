# Physical containers have physical meaning. Do not add invisible layout wrappers.
classes: {
  module: {style: {fill: "#f5f8fc"; stroke: "#355877"; stroke-width: 2; font-size: 24; bold: true}}
  ebox: {style: {bold: false; fill: "#fff8ef"; stroke: "#a66a28"; stroke-width: 2; font-size: 20}}
  cryostat: {style: {bold: false; fill: "#edf8f8"; stroke: "#397c83"; stroke-width: 3; font-size: 20}}
  room: {style: {bold: false; fill: "#f8f9fa"; stroke: "#718096"; stroke-width: 2; font-size: 22}}
  device: {style: {bold: false; fill: "#ffffff"; stroke: "#536575"; stroke-width: 2; font-size: 20; border-radius: 5}}
  computer: {style: {bold: false; fill: "#e6f1fd"; stroke: "#23659a"; stroke-width: 2; font-size: 20; border-radius: 6}}
  controller: {style: {bold: false; fill: "#eee8fa"; stroke: "#7857a0"; stroke-width: 2; font-size: 20; border-radius: 5}}
  actuator: {style: {bold: false; fill: "#fff0ed"; stroke: "#ad5143"; stroke-width: 2; font-size: 20; border-radius: 5}}
  camera: {style: {bold: false; fill: "#f9e9f1"; stroke: "#a94476"; stroke-width: 2; font-size: 20; border-radius: 5}}
  utility: {style: {bold: false; fill: "#f0f2f4"; stroke: "#687582"; stroke-width: 2; font-size: 20}}
  manifold: {style: {bold: false; fill: "#e5f4ee"; stroke: "#377b65"; stroke-width: 2; font-size: 20}}
  panel: {shape: sql_table; style: {bold: false; fill: "#c9d9e8"; stroke: "#f0f5f9"; font-color: "#19324d"; stroke-width: 2; font-size: 18}}
  optional: {style.stroke-dash: 5}
  placeholder: {style: {fill: "#fff3d7"; stroke: "#967016"; stroke-dash: 2}}
  doc: {style: {bold: false; fill: "#e6f1fd"; stroke: "#23659a"; stroke-width: 2; font-size: 20; underline: true}}
  title: {shape: text; style: {font-size: 28; bold: true; font-color: "#23425a"}}
  power: {style: {italic: false; font-color: "#35465a"; stroke: "#374151"; stroke-width: 2}; label: AC}
  dc: {style: {italic: false; font-color: "#35465a"; stroke: "#66717f"; stroke-width: 2; stroke-dash: 3}; label: DC}
  ethernet: {style: {italic: false; font-color: "#35465a"; stroke: "#236bb0"; stroke-width: 2}; label: Ethernet}
  ethercat: {style: {italic: false; font-color: "#35465a"; stroke: "#c57213"; stroke-width: 3}; label: EtherCAT}
  usb: {style: {italic: false; font-color: "#35465a"; stroke: "#236bb0"; stroke-width: 2; stroke-dash: 4}; label: USB}
  serial: {style: {italic: false; font-color: "#35465a"; stroke: "#6877a9"; stroke-width: 2; stroke-dash: 2}; label: Serial}
  motion: {style: {italic: false; font-color: "#35465a"; stroke: "#b95146"; stroke-width: 2}; label: "Motor / position"}
  trigger: {style: {italic: false; font-color: "#35465a"; stroke: "#4f8728"; stroke-width: 3}; label: Trigger}
  detector: {style: {italic: false; font-color: "#35465a"; stroke: "#a44582"; stroke-width: 3}; label: Detector}
  cxp: {style: {italic: false; font-color: "#35465a"; stroke: "#a44582"; stroke-width: 3}; label: "CXP ×4"}
  glycol: {style: {italic: false; font-color: "#35465a"; stroke: "#218a86"; stroke-width: 3}; label: "Glycol S/R"}
  air: {style: {italic: false; font-color: "#35465a"; stroke: "#5488a1"; stroke-width: 2; stroke-dash: 3}; label: Air}
  vacuum: {style: {italic: false; font-color: "#35465a"; stroke: "#657b52"; stroke-width: 3}; label: Vacuum}
  sense: {style: {italic: false; font-color: "#35465a"; stroke: "#559376"; stroke-width: 2; stroke-dash: 2}; label: I/O}
  optical: {style: {italic: false; font-color: "#35465a"; stroke: "#c99116"; stroke-width: 3}; label: ""}
  helium: {style: {italic: false; font-color: "#35465a"; stroke: "#7b9a8b"; stroke-width: 3}; label: "Helium pair"}
  thermal: {style: {italic: false; font-color: "#35465a"; stroke: "#218a86"; stroke-width: 4}; label: "Thermal contact"}
  control: {style: {italic: false; font-color: "#35465a"; stroke: "#236bb0"; stroke-width: 2}; label: ""}
  data: {style: {italic: false; font-color: "#35465a"; stroke: "#a44582"; stroke-width: 3}; label: ""}
}
