zspec_vis: {
  label: "ZSpec VIS"
  class: module
  link: "../../controls/harnesses/zspec-vis.html"
  ebox: {
    label: "VIS EBox"
    class: ebox
    link: "../../controls/harnesses/zspec-vis.html"
    input_panel: {
      label: "Service input panel"
      class: panel
      link: "../../controls/harnesses/zspec-vis.html"
      AC: "Power"
      NET: "Control / readout"
    }
    motion_panel: {
      label: "Mechanism panel"
      class: panel
      link: "../../controls/harnesses/zspec-vis.html"
      PREOPTIC: "First pre-optic focus"
      ADC_A: "ADC prism A"
      ADC_B: "ADC prism B"
      ROTATOR: "Field rotator"
      STEER_X: "X steering"
      STEER_Y: "Y steering"
      SLIT: "Slit selector"
      FOCUS_B: "B detector focus"
      FOCUS_G: "G detector focus"
      FOCUS_R: "R detector focus"
    }
    aux_panel: {
      label: "Auxiliary panel"
      class: panel
      link: "../../controls/harnesses/zspec-vis.html"
      TEMP: "Enclosure probes"
      CAM_POWER: "Slit viewer DC"
      CAM_DATA: "Slit viewer data"
      GAUGES: "Vacuum readout"
      GAUGE_DC: "Gauge power"
      VALVE_DC: "Gate-valve power"
    }
    cooling_panel: {
      label: "Cooling panel"
      class: panel
      link: "../../controls/harnesses/zspec-vis.html#glycol-connections"
      GLYCOL: "Supply / return"
    }
    power_bus: {label: "AC distribution"; class: utility; link: "../../controls/harnesses/zspec-vis.html"}
    dc: {label: "DC supply"; class: utility; link: "../../controls/harnesses/zspec-vis.html"}
    network_switch: {label: "Local switch"; class: computer; link: "../../controls/harnesses/zspec-vis.html"}
    computer: {label: "Module host"; class: computer; link: "../../controls/operations/computer-management.html"}
    master: {label: "Beckhoff master"; class: controller; link: "../../controls/harnesses/zspec-vis.html"}
    motion_drives: {label: "Motion drives"; class: controller; link: "../../controls/harnesses/zspec-vis.html"}
    temperature_hub: {label: "1-Wire hub"; class: controller; link: "../../controls/harnesses/zspec-vis.html"}
    heat_exchanger: {label: "EBox heat exchanger"; class: device; link: "../../controls/harnesses/zspec-vis.html"}
    input_panel.AC -- power_bus: {class: power}
    power_bus -- dc: {class: power}
    input_panel.NET -- network_switch: {class: ethernet}
    dc -- computer: {class: dc}
    dc -- master: {class: dc}
    dc -- network_switch: {class: dc}
    dc -- motion_drives: {class: dc}
    network_switch -- computer: {class: ethernet}
    network_switch -- master: {class: ethernet}
    master -- motion_drives: {class: ethercat}
    computer -- temperature_hub: {class: usb}
    temperature_hub -- aux_panel.TEMP: {class: sense; label: "1-Wire"}
    motion_drives -- motion_panel.PREOPTIC: {class: motion}
    motion_drives -- motion_panel.ADC_A: {class: motion}
    motion_drives -- motion_panel.ADC_B: {class: motion}
    motion_drives -- motion_panel.ROTATOR: {class: motion}
    motion_drives -- motion_panel.STEER_X: {class: motion}
    motion_drives -- motion_panel.STEER_Y: {class: motion}
    motion_drives -- motion_panel.SLIT: {class: motion}
    motion_drives -- motion_panel.FOCUS_B: {class: motion}
    motion_drives -- motion_panel.FOCUS_G: {class: motion}
    motion_drives -- motion_panel.FOCUS_R: {class: motion}
    cooling_panel.GLYCOL -- heat_exchanger: {class: glycol}
    readout_panel: {
      label: "Readout panel"
      class: panel
      link: "../../controls/harnesses/zspec-vis.html"
      B_POWER: "Archon DC"
      B_NET: "Archon network"
      B_TRIG: "Shutter trigger"
      G_POWER: "Archon DC"
      G_NET: "Archon network"
      G_TRIG: "Shutter trigger"
      R_POWER: "Archon DC"
      R_NET: "Archon network"
      R_TRIG: "Shutter trigger"
    }
    shutter_or: {label: "Shutter hardware OR"; class: controller; link: "../../controls/harnesses/zspec-vis.html#shutter-triggers"}
    shutter_controller: {label: "Shutter controller"; class: controller; link: "../../controls/harnesses/zspec-vis.html#shutter-triggers"}
    dc -- readout_panel.B_POWER: {class: dc}
    network_switch -- readout_panel.B_NET: {class: ethernet}
    readout_panel.B_TRIG -> shutter_or: {class: trigger; label: "B"}
    dc -- readout_panel.G_POWER: {class: dc}
    network_switch -- readout_panel.G_NET: {class: ethernet}
    readout_panel.G_TRIG -> shutter_or: {class: trigger; label: "G"}
    dc -- readout_panel.R_POWER: {class: dc}
    network_switch -- readout_panel.R_NET: {class: ethernet}
    readout_panel.R_TRIG -> shutter_or: {class: trigger; label: "R"}
    shutter_or -> shutter_controller: {class: trigger}
    dc -- shutter_or: {class: dc}
    dc -- shutter_controller: {class: dc}
    master -- shutter_controller: {class: ethercat}
    shutter_controller -- motion_panel.SHUTTER: {class: motion}
    dc -- aux_panel.CAM_POWER: {class: dc}
    computer -- aux_panel.CAM_DATA: {class: usb}
    gauge_interface: {label: "Gauge interface"; class: controller; link: "../../controls/harnesses/zspec-vis.html"}
    computer -- gauge_interface: {class: usb}
    gauge_interface -- aux_panel.GAUGES: {class: serial}
    dc -- aux_panel.GAUGE_DC: {class: dc}
    dc -- aux_panel.VALVE_DC: {class: dc}
    motion_panel.SHUTTER: "Entrance shutter"
    motion_panel.SLITCAM: "Slit viewer focus"
    motion_drives -- motion_panel.SLITCAM: {class: [motion; optional]}
    nir_panel: {
      label: "NIR service panel"
      class: panel
      link: "../../controls/harnesses/zspec-vis.html#vis-ebox-to-nir-ebox"
      DC: "Power"
      NET: "Control / readout"
    }
    dc -- nir_panel.DC: {class: dc}
    network_switch -- nir_panel.NET: {class: ethernet}
    cryo_panel: {
      label: "Cryocooler panel"
      class: panel
      link: "../../controls/harnesses/zspec-vis.html"
      B: "Coldhead power / control"
      G: "Coldhead power / control"
      R: "Coldhead power / control"
    }
    cryo_b: {label: "B Cryotel controller"; class: controller; link: "../../controls/harnesses/zspec-vis.html"}
    dc -- cryo_b: {class: dc}
    computer -- cryo_b: {class: usb}
    cryo_b -- cryo_panel.B: {class: sense; label: "Power + control"}
    cryo_g: {label: "G Cryotel controller"; class: controller; link: "../../controls/harnesses/zspec-vis.html"}
    dc -- cryo_g: {class: dc}
    computer -- cryo_g: {class: usb}
    cryo_g -- cryo_panel.G: {class: sense; label: "Power + control"}
    cryo_r: {label: "R Cryotel controller"; class: controller; link: "../../controls/harnesses/zspec-vis.html"}
    dc -- cryo_r: {class: dc}
    computer -- cryo_r: {class: usb}
    cryo_r -- cryo_panel.R: {class: sense; label: "Power + control"}
  }
  service_panel: {
    label: "Fluid service panel"
    class: panel
    link: "../../controls/harnesses/zspec-vis.html"
    GLYCOL: "Supply / return"
    AIR: "Enclosure air"
  }
  glycol_manifold: {label: "VIS glycol manifold"; class: manifold; link: "../../controls/harnesses/zspec-vis.html#glycol-connections"}
  air_dryer: {label: "Enclosure air dryer"; class: utility; link: "../../controls/harnesses/zspec-vis.html#air-connections"}
  service_panel.GLYCOL -- glycol_manifold: {class: glycol}
  glycol_manifold -- ebox.cooling_panel.GLYCOL: {class: glycol}
  service_panel.AIR -- air_dryer: {class: air}
  preoptic_focus: {label: "First pre-optic focus"; class: actuator; link: "../../controls/operations/zspec.html"}
  ebox.motion_panel.PREOPTIC -- preoptic_focus: {class: motion}
  adc_a: {label: "ADC prism A"; class: actuator; link: "../../controls/operations/zspec.html"}
  ebox.motion_panel.ADC_A -- adc_a: {class: motion}
  adc_b: {label: "ADC prism B"; class: actuator; link: "../../controls/operations/zspec.html"}
  ebox.motion_panel.ADC_B -- adc_b: {class: motion}
  rotator: {label: "Field rotator"; class: actuator; link: "../../controls/operations/zspec.html"}
  ebox.motion_panel.ROTATOR -- rotator: {class: motion}
  steer_x: {label: "X steering"; class: actuator; link: "../../controls/operations/zspec.html"}
  ebox.motion_panel.STEER_X -- steer_x: {class: motion}
  steer_y: {label: "Y steering"; class: actuator; link: "../../controls/operations/zspec.html"}
  ebox.motion_panel.STEER_Y -- steer_y: {class: motion}
  slit: {label: "Slit selector"; class: actuator; link: "../../controls/operations/zspec.html"}
  ebox.motion_panel.SLIT -- slit: {class: motion}
  shutter: {label: "Entrance shutter"; class: actuator; link: "../../controls/operations/zspec.html"}
  ebox.motion_panel.SHUTTER -- shutter: {class: motion}
  slit_viewer: {label: "VIS slit viewer"; class: camera; link: "../../controls/harnesses/zspec-vis.html#slit-viewer-connections"}
  slit_view_focus: {label: "Slit viewer focus"; class: [actuator; optional]; link: "../../controls/operations/zspec.html"}
  ebox.motion_panel.SLITCAM -- slit_view_focus: {class: [motion; optional]}
  ebox.aux_panel.CAM_POWER -- slit_viewer: {class: dc}
  ebox.aux_panel.CAM_DATA -- slit_viewer: {class: usb}
  enclosure_probes: {label: "Enclosure probes"; class: device; link: "../../controls/harnesses/zspec-vis.html"}
  ebox.aux_panel.TEMP -- enclosure_probes: {class: sense; label: "1-Wire"}
  archon_b: {label: "B Archon"; class: [controller; placeholder]; link: "../../controls/harnesses/zspec-vis.html#detector-harnesses-and-feedthroughs"; tooltip: "One Archon per detector: ledger baseline."}
  ebox.readout_panel.B_POWER -- archon_b: {class: dc}
  ebox.readout_panel.B_NET -- archon_b: {class: ethernet}
  archon_b -> ebox.readout_panel.B_TRIG: {class: trigger; label: "B"}
  glycol_manifold -- archon_b: {class: glycol}
  dewar_b: {
    label: "B detector vessel"
    class: cryostat
    link: "../../controls/harnesses/zspec-vis.html"
    vib: {
      label: "B detector VIB"
      class: panel
      link: "../../controls/harnesses/zspec-vis.html#detector-harnesses-and-feedthroughs"
      DET: "Detector harness"
      FOCUS: "Focus motor / position"
      THERM: "Detector thermal circuits"
    }
    detector: {label: "B STA5900q"; class: camera; link: "../../controls/operations/zspec.html"}
    focus: {label: "B detector focus"; class: actuator; link: "../../controls/operations/zspec.html"}
    vib.DET -- detector: {class: detector}
    vib.FOCUS -- focus: {class: motion}
    vib.THERM -- detector: {class: sense; label: "Temperature / heater"}
    service_ports: {
      label: "B vessel ports"
      class: panel
      link: "../../controls/harnesses/zspec-vis.html"
      VAC: "Vacuum"
      COLD: "Coldhead interface"
    }
  }
  archon_b -- dewar_b.vib.DET: {class: detector}
  archon_b -- dewar_b.vib.THERM: {class: sense; label: "Temperature / heater"}
  ebox.motion_panel.FOCUS_B -- dewar_b.vib.FOCUS: {class: motion}
  coldhead_b: {label: "B Cryotel coldhead"; class: device; link: "../../controls/harnesses/zspec-vis.html"}
  ebox.cryo_panel.B -- coldhead_b: {class: sense; label: "Power + control"}
  glycol_manifold -- coldhead_b: {class: glycol}
  coldhead_b -- dewar_b.service_ports.COLD: {class: thermal; label: "Cold finger"}
  gauge_b: {label: "B vacuum gauge"; class: device; link: "../../controls/harnesses/vacuum.html"}
  valve_b: {label: "B automatic gate valve"; class: controller; link: "../../controls/harnesses/vacuum.html"}
  ebox.aux_panel.GAUGES -- gauge_b: {class: serial}
  ebox.aux_panel.GAUGE_DC -- gauge_b: {class: dc}
  ebox.aux_panel.VALVE_DC -- valve_b: {class: dc}
  gauge_b -- dewar_b.service_ports.VAC: {class: vacuum}
  valve_b -- dewar_b.service_ports.VAC: {class: vacuum}
  archon_g: {label: "G Archon"; class: [controller; placeholder]; link: "../../controls/harnesses/zspec-vis.html#detector-harnesses-and-feedthroughs"; tooltip: "One Archon per detector: ledger baseline."}
  ebox.readout_panel.G_POWER -- archon_g: {class: dc}
  ebox.readout_panel.G_NET -- archon_g: {class: ethernet}
  archon_g -> ebox.readout_panel.G_TRIG: {class: trigger; label: "G"}
  glycol_manifold -- archon_g: {class: glycol}
  dewar_g: {
    label: "G detector vessel"
    class: cryostat
    link: "../../controls/harnesses/zspec-vis.html"
    vib: {
      label: "G detector VIB"
      class: panel
      link: "../../controls/harnesses/zspec-vis.html#detector-harnesses-and-feedthroughs"
      DET: "Detector harness"
      FOCUS: "Focus motor / position"
      THERM: "Detector thermal circuits"
    }
    detector: {label: "G STA5900q"; class: camera; link: "../../controls/operations/zspec.html"}
    focus: {label: "G detector focus"; class: actuator; link: "../../controls/operations/zspec.html"}
    vib.DET -- detector: {class: detector}
    vib.FOCUS -- focus: {class: motion}
    vib.THERM -- detector: {class: sense; label: "Temperature / heater"}
    service_ports: {
      label: "G vessel ports"
      class: panel
      link: "../../controls/harnesses/zspec-vis.html"
      VAC: "Vacuum"
      COLD: "Coldhead interface"
    }
  }
  archon_g -- dewar_g.vib.DET: {class: detector}
  archon_g -- dewar_g.vib.THERM: {class: sense; label: "Temperature / heater"}
  ebox.motion_panel.FOCUS_G -- dewar_g.vib.FOCUS: {class: motion}
  coldhead_g: {label: "G Cryotel coldhead"; class: device; link: "../../controls/harnesses/zspec-vis.html"}
  ebox.cryo_panel.G -- coldhead_g: {class: sense; label: "Power + control"}
  glycol_manifold -- coldhead_g: {class: glycol}
  coldhead_g -- dewar_g.service_ports.COLD: {class: thermal; label: "Cold finger"}
  gauge_g: {label: "G vacuum gauge"; class: device; link: "../../controls/harnesses/vacuum.html"}
  valve_g: {label: "G automatic gate valve"; class: controller; link: "../../controls/harnesses/vacuum.html"}
  ebox.aux_panel.GAUGES -- gauge_g: {class: serial}
  ebox.aux_panel.GAUGE_DC -- gauge_g: {class: dc}
  ebox.aux_panel.VALVE_DC -- valve_g: {class: dc}
  gauge_g -- dewar_g.service_ports.VAC: {class: vacuum}
  valve_g -- dewar_g.service_ports.VAC: {class: vacuum}
  archon_r: {label: "R Archon"; class: [controller; placeholder]; link: "../../controls/harnesses/zspec-vis.html#detector-harnesses-and-feedthroughs"; tooltip: "One Archon per detector: ledger baseline."}
  ebox.readout_panel.R_POWER -- archon_r: {class: dc}
  ebox.readout_panel.R_NET -- archon_r: {class: ethernet}
  archon_r -> ebox.readout_panel.R_TRIG: {class: trigger; label: "R"}
  glycol_manifold -- archon_r: {class: glycol}
  dewar_r: {
    label: "R detector vessel"
    class: cryostat
    link: "../../controls/harnesses/zspec-vis.html"
    vib: {
      label: "R detector VIB"
      class: panel
      link: "../../controls/harnesses/zspec-vis.html#detector-harnesses-and-feedthroughs"
      DET: "Detector harness"
      FOCUS: "Focus motor / position"
      THERM: "Detector thermal circuits"
    }
    detector: {label: "R STA5900q"; class: camera; link: "../../controls/operations/zspec.html"}
    focus: {label: "R detector focus"; class: actuator; link: "../../controls/operations/zspec.html"}
    vib.DET -- detector: {class: detector}
    vib.FOCUS -- focus: {class: motion}
    vib.THERM -- detector: {class: sense; label: "Temperature / heater"}
    service_ports: {
      label: "R vessel ports"
      class: panel
      link: "../../controls/harnesses/zspec-vis.html"
      VAC: "Vacuum"
      COLD: "Coldhead interface"
    }
  }
  archon_r -- dewar_r.vib.DET: {class: detector}
  archon_r -- dewar_r.vib.THERM: {class: sense; label: "Temperature / heater"}
  ebox.motion_panel.FOCUS_R -- dewar_r.vib.FOCUS: {class: motion}
  coldhead_r: {label: "R Cryotel coldhead"; class: device; link: "../../controls/harnesses/zspec-vis.html"}
  ebox.cryo_panel.R -- coldhead_r: {class: sense; label: "Power + control"}
  glycol_manifold -- coldhead_r: {class: glycol}
  coldhead_r -- dewar_r.service_ports.COLD: {class: thermal; label: "Cold finger"}
  gauge_r: {label: "R vacuum gauge"; class: device; link: "../../controls/harnesses/vacuum.html"}
  valve_r: {label: "R automatic gate valve"; class: controller; link: "../../controls/harnesses/vacuum.html"}
  ebox.aux_panel.GAUGES -- gauge_r: {class: serial}
  ebox.aux_panel.GAUGE_DC -- gauge_r: {class: dc}
  ebox.aux_panel.VALVE_DC -- valve_r: {class: dc}
  gauge_r -- dewar_r.service_ports.VAC: {class: vacuum}
  valve_r -- dewar_r.service_ports.VAC: {class: vacuum}
}
