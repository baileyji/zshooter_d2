zimage: {
  label: "ZImager"
  class: module
  link: "../../controls/harnesses/zimager.html"
  ebox: {
    label: "ZImager EBox"
    class: ebox
    link: "../../controls/harnesses/zimager.html"
    input_panel: {
      label: "Service input panel"
      class: panel
      link: "../../controls/harnesses/zimager.html"
      AC: "Power"
      NET: "Control / readout"
    }
    motion_panel: {
      label: "Mechanism panel"
      class: panel
      link: "../../controls/harnesses/zimager.html"
      ADC_A: "ADC prism A"
      ADC_B: "ADC prism B"
      ROT_U: "U detector rotator"
      ROT_V: "V detector rotator"
      ROT_Z: "Z detector rotator"
      FOCUS: "Common focus"
    }
    aux_panel: {
      label: "Auxiliary panel"
      class: panel
      link: "../../controls/harnesses/zimager.html"
      TEMP: "Enclosure probes"
    }
    cooling_panel: {
      label: "Cooling panel"
      class: panel
      link: "../../controls/harnesses/zimager.html#glycol-connections"
      GLYCOL: "Supply / return"
    }
    power_bus: {label: "AC distribution"; class: utility; link: "../../controls/harnesses/zimager.html"}
    dc: {label: "DC supply"; class: utility; link: "../../controls/harnesses/zimager.html"}
    network_switch: {label: "Local switch"; class: computer; link: "../../controls/harnesses/zimager.html"}
    computer: {label: "Module host"; class: computer; link: "../../controls/operations/computer-management.html"}
    master: {label: "Beckhoff master"; class: controller; link: "../../controls/harnesses/zimager.html"}
    motion_drives: {label: "Motion drives"; class: controller; link: "../../controls/harnesses/zimager.html"}
    temperature_hub: {label: "1-Wire hub"; class: controller; link: "../../controls/harnesses/zimager.html"}
    heat_exchanger: {label: "EBox heat exchanger"; class: device; link: "../../controls/harnesses/zimager.html"}
    input_panel.AC -- power_bus: {class: power}
    power_bus -- dc: {class: power}
    input_panel.NET -- network_switch: {class: ethernet}
    dc -- computer: {class: dc}
    dc -- master: {class: dc}
    dc -- network_switch: {class: dc}
    dc -- motion_drives: {class: dc}
    network_switch -- computer: {class: ethernet}
    network_switch -- master: {class: ethernet}
    master -- motion_drives: {class: ethercat}
    computer -- temperature_hub: {class: usb}
    temperature_hub -- aux_panel.TEMP: {class: sense; label: "1-Wire"}
    motion_drives -- motion_panel.ADC_A: {class: motion}
    motion_drives -- motion_panel.ADC_B: {class: motion}
    motion_drives -- motion_panel.ROT_U: {class: motion}
    motion_drives -- motion_panel.ROT_V: {class: motion}
    motion_drives -- motion_panel.ROT_Z: {class: motion}
    motion_drives -- motion_panel.FOCUS: {class: motion}
    cooling_panel.GLYCOL -- heat_exchanger: {class: glycol}
    filter_panel: {
      label: "Filter panel"
      class: panel
      link: "../../controls/harnesses/zimager.html"
      USB: "V filter"
    }
    computer -- filter_panel.USB: {class: usb}
    detector_power_panel: {
      label: "Detector power panel"
      class: panel
      link: "../../controls/harnesses/zimager.html"
      U: "12 VDC"
      V: "12 VDC"
      Z: "12 VDC"
    }
    dc -- detector_power_panel.U: {class: dc; label: "12 VDC"}
    dc -- detector_power_panel.V: {class: dc; label: "12 VDC"}
    dc -- detector_power_panel.Z: {class: dc; label: "12 VDC"}
  }
  readout_panel: {
    label: "Detector readout panel"
    class: panel
    link: "../../controls/harnesses/zimager.html#detector-readout"
    U: "CoaXPress ×4"
    V: "CoaXPress ×4"
    Z: "CoaXPress ×4"
  }
  cxp_transport: {
    label: "CXP optical transmitters"
    class: panel
    link: "../../controls/harnesses/zimager.html#detector-readout"
    U: "Coax ↔ fiber"
    V: "Coax ↔ fiber"
    Z: "Coax ↔ fiber"
    DC: "Converter power"
  }
  cxp_transport.class: [panel; placeholder]
  ebox.detector_power_panel.OPTICS: "Converter DC"
  ebox.dc -- ebox.detector_power_panel.OPTICS: {class: dc}
  ebox.detector_power_panel.OPTICS -- cxp_transport.DC: {class: dc}
  readout_panel.U -- cxp_transport.U: {class: cxp; label: "U"}
  readout_panel.V -- cxp_transport.V: {class: cxp; label: "V"}
  readout_panel.Z -- cxp_transport.Z: {class: cxp; label: "Z"}
  service_panel: {
    label: "Fluid service panel"
    class: panel
    link: "../../controls/harnesses/zimager.html"
    GLYCOL: "Supply / return"
    AIR: "Enclosure air"
  }
  glycol_manifold: {label: "Glycol submanifold"; class: manifold; link: "../../controls/harnesses/zimager.html#glycol-connections"}
  enclosure_probes: {label: "Enclosure probes"; class: device; link: "../../controls/harnesses/zimager.html"}
  adc_a: {label: "ADC prism A"; class: actuator; link: "../../controls/operations/zimager.html"}
  adc_b: {label: "ADC prism B"; class: actuator; link: "../../controls/operations/zimager.html"}
  u_rotator: {label: "U detector rotator"; class: actuator; link: "../../controls/operations/zimager.html"}
  v_rotator: {label: "V detector rotator"; class: actuator; link: "../../controls/operations/zimager.html"}
  z_rotator: {label: "Z detector rotator"; class: actuator; link: "../../controls/operations/zimager.html"}
  focus: {label: "Common focus"; class: actuator; link: "../../controls/operations/zimager.html"}
  filter: {label: "V filter"; class: actuator; link: "../../controls/operations/zimager.html"}
  ebox.motion_panel.ADC_A -- adc_a: {class: motion}
  ebox.motion_panel.ADC_B -- adc_b: {class: motion}
  ebox.motion_panel.ROT_U -- u_rotator: {class: motion}
  ebox.motion_panel.ROT_V -- v_rotator: {class: motion}
  ebox.motion_panel.ROT_Z -- z_rotator: {class: motion}
  ebox.motion_panel.FOCUS -- focus: {class: motion}
  ebox.filter_panel.USB -- filter: {class: usb}
  ebox.aux_panel.TEMP -- enclosure_probes: {class: sense; label: "1-Wire"}
  service_panel.GLYCOL -- glycol_manifold: {class: glycol}
  glycol_manifold -- ebox.cooling_panel.GLYCOL: {class: glycol}
  u_detector: {label: "U ORCA-Quest 2"; class: camera; link: "../../controls/operations/zimager.html#detector-acquisition"}
  readout_panel.U -- u_detector: {class: cxp}
  glycol_manifold -- u_detector: {class: glycol}
  ebox.detector_power_panel.U -- u_detector: {class: dc; label: "12 VDC"}
  v_detector: {label: "V ORCA-Quest 2"; class: camera; link: "../../controls/operations/zimager.html#detector-acquisition"}
  readout_panel.V -- v_detector: {class: cxp}
  glycol_manifold -- v_detector: {class: glycol}
  ebox.detector_power_panel.V -- v_detector: {class: dc; label: "12 VDC"}
  z_detector: {label: "Z ORCA-Quest 2"; class: camera; link: "../../controls/operations/zimager.html#detector-acquisition"}
  readout_panel.Z -- z_detector: {class: cxp}
  glycol_manifold -- z_detector: {class: glycol}
  ebox.detector_power_panel.Z -- z_detector: {class: dc; label: "12 VDC"}
  air_dryer: {label: "Enclosure air dryer"; class: utility; link: "../../controls/harnesses/zimager.html#air-connections"}
  service_panel.AIR -- air_dryer: {class: air}
}
