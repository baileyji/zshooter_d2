telescope: @../models/concepts.telescope
neighbor_selector: {label: "Neighbor selector"; class: actuator; link: "../../controls/operations/zfront-zcal.html"}
neighbors: {label: "Neighboring instruments"; class: device; link: "../../controls/operations/zfront-zcal.html"}
sources: {label: "Calibration sources"; class: device; link: "../../controls/operations/zfront-zcal.html"}
point: {label: "Point / diffuse selector"; class: actuator; link: "../../controls/operations/zfront-zcal.html"}
insert: {label: "Calibration inserter"; class: actuator; link: "../../controls/operations/zfront-zcal.html"}
select: {label: "ZImager / ZSpec selector"; class: actuator; link: "../../controls/operations/zfront-zcal.html"}
telescope -> neighbor_selector: {class: optical}
neighbor_selector -> select: {class: optical}
neighbor_selector -> neighbors: {class: optical}
sources -> point: {class: optical}
point -> insert: {class: optical}
insert -> select: {class: optical}
zimage: {
  label: "ZImager"
  class: module
  link: "../../controls/harnesses/zimager.html"
  adc: {label: "ADC pair"; class: device; link: "../../controls/operations/zimager.html"}
  split: {label: "Channel dichroics"; class: device; link: "../../controls/operations/zimager.html"}
  filter: {label: "V filter"; class: device; link: "../../controls/operations/zimager.html"}
  u: {label: "U camera / detector"; class: camera; link: "../../controls/operations/zimager.html"}
  v: {label: "V camera / detector"; class: camera; link: "../../controls/operations/zimager.html"}
  z: {label: "Z camera / detector"; class: camera; link: "../../controls/operations/zimager.html"}
  adc -> split: {class: optical}
  split -> u: {class: optical}
  split -> filter: {class: optical}
  filter -> v: {class: optical}
  split -> z: {class: optical}
}
select -> zimage.adc: {class: optical}
splitter: {label: "VIS / NIR dichroic"; class: device; link: "../../controls/operations/zspec.html"}
select -> splitter: {class: optical}
vis: {
  label: "ZSpec VIS"
  class: module
  link: "../../controls/harnesses/zspec-vis.html"
  shutter: {label: "Entrance shutter"; class: device; link: "../../controls/operations/zspec.html"}
  preoptic: {label: "First pre-optic\nRelative focus"; class: device; link: "../../controls/operations/zspec.html"}
  rotator: {label: "Field rotator"; class: device; link: "../../controls/operations/zspec.html"}
  adc: {label: "ADC pair"; class: device; link: "../../controls/operations/zspec.html"}
  steer: {label: "X / Y steering"; class: device; link: "../../controls/operations/zspec.html"}
  slit: {label: "Slit"; class: device; link: "../../controls/operations/zspec.html"}
  spectrograph: {label: "VIS spectrograph"; class: device; link: "../../controls/operations/zspec.html"}
  detectors: {label: "B / G / R detectors"; class: camera; link: "../../controls/operations/zspec.html"}
  viewer: {label: "VIS slit viewer"; class: camera; link: "../../controls/operations/zspec.html"}
  shutter -> preoptic: {class: optical}
  preoptic -> rotator: {class: optical}
  rotator -> adc: {class: optical}
  adc -> steer: {class: optical}
  steer -> slit: {class: optical}
  slit -> spectrograph: {class: optical}
  spectrograph -> detectors: {class: optical}
  slit -> viewer: {class: optical}
}
splitter -> vis.shutter: {class: optical}
nir: {
  label: "NIR cryostat"
  class: cryostat
  link: "../../controls/harnesses/zspec-nir.html"
  foreoptics: {label: "Cold fore-optics"; class: device; link: "../../controls/operations/zspec.html"; tooltip: "Field rotation, ADC, steering and the rotating cold pupil are represented in the physical connection view."}
  shutter: {label: "Cold shutter"; class: device; link: "../../controls/harnesses/zspec-nir.html"}
  slit: {label: "Slit"; class: device; link: "../../controls/harnesses/zspec-nir.html"}
  spectrograph: {label: "NIR spectrograph"; class: device; link: "../../controls/harnesses/zspec-nir.html"}
  detectors: {label: "YJ / H / K detectors"; class: camera; link: "../../controls/harnesses/zspec-nir.html"}
  port: {label: "Baffled optical port\nCold shortpass filter"; class: device; link: "../../controls/harnesses/zspec-nir.html"}
  shutter -> foreoptics: {class: optical}
  foreoptics -> slit: {class: optical}
  slit -> spectrograph: {class: optical}
  spectrograph -> detectors: {class: optical}
  slit -> port: {class: optical}
}
cred2: {label: "CRED2 slit viewer"; class: camera; link: "../../controls/harnesses/zspec-nir.html#slit-viewer-connections"}
splitter -> nir.shutter: {class: optical}
nir.port -> cred2: {class: optical}
