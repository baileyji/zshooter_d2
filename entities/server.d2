server: {
  label: "Server room"
  class: room
  link: "../../controls/harnesses/server.html"
  facility_panel: {
    label: "Rack service panel"
    class: panel
    link: "../../controls/harnesses/server.html"
    AC: "Power"
    NET: "Facility uplink"
  }
  readout_panel: {
    label: "Imager readout panel"
    class: panel
    link: "../../controls/harnesses/server.html#readout-interfaces"
    U: "CXP optical transport"
    V: "CXP optical transport"
    Z: "CXP optical transport"
  }
  ups: {label: "Managed UPS"; class: utility; link: "../../controls/operations/computer-management.html"}
  network_switch: {label: "Server switch"; class: computer; link: "../../controls/operations/computer-management.html"}
  reduction_computer: {label: "DRP computer"; class: computer; link: "../../controls/operations/computer-management.html"}
  nas: {label: "NAS / NFS"; class: computer; link: "../../controls/operations/computer-management.html"}
  zspec_readout_computer: {label: "ZSpec readout host"; class: computer; link: "../../controls/operations/computer-management.html"}
  zimage_readout_computer: {
    label: "ZImager readout host"
    class: computer
    link: "../../controls/harnesses/server.html"
    card_u: {label: "U CXP card"; class: controller; link: "../../controls/harnesses/server.html"}
    card_v: {label: "V CXP card"; class: controller; link: "../../controls/harnesses/server.html"}
    card_z: {label: "Z CXP card"; class: controller; link: "../../controls/harnesses/server.html"}
  }
  cxp_transport: {
    label: "CXP optical receivers"
    class: panel
    link: "../../controls/harnesses/server.html"
    U: "Optical ↔ CoaXPress"
    V: "Optical ↔ CoaXPress"
    Z: "Optical ↔ CoaXPress"
    DC: "Converter power"
  }
  cxp_transport.class: [panel; placeholder]
  converter_supply: {label: "CXP converter supply"; class: [utility; placeholder]; link: "../../controls/harnesses/server.html"}
  ups -- converter_supply: {class: power}
  converter_supply -- cxp_transport.DC: {class: dc}
  facility_panel.AC -- ups: {class: power}
  facility_panel.NET -- network_switch: {class: ethernet}
  ups -- network_switch: {class: power}
  ups -- reduction_computer: {class: power}
  ups -- nas: {class: power}
  ups -- zspec_readout_computer: {class: power}
  ups -- zimage_readout_computer: {class: power}
  network_switch -- ups: {class: ethernet}
  network_switch -- reduction_computer: {class: ethernet}
  network_switch -- nas: {class: ethernet}
  network_switch -- zspec_readout_computer: {class: ethernet}
  network_switch -- zimage_readout_computer: {class: ethernet}
  readout_panel.U -- cxp_transport.U: {class: cxp; label: "U"}
  cxp_transport.U -- zimage_readout_computer.card_u: {class: cxp; label: "U"}
  readout_panel.V -- cxp_transport.V: {class: cxp; label: "V"}
  cxp_transport.V -- zimage_readout_computer.card_v: {class: cxp; label: "V"}
  readout_panel.Z -- cxp_transport.Z: {class: cxp; label: "Z"}
  cxp_transport.Z -- zimage_readout_computer.card_z: {class: cxp; label: "Z"}
}
